# Lokale Entwicklung. Kopieren nach .env und anpassen – .env niemals committen.

# MariaDB (db/run_mariadb.sh liest dieselben Werte)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ladedaten
DB_USER=ladedaten
DB_PASSWORD=wähle-ein-sicheres-passwort
DB_ROOT_PASSWORD=wähle-ein-anderes-sicheres-passwort

# Erzeugen mit: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Lokal ohne HTTPS: false. In Kubernetes (hinter TLS-Ingress) immer true.
SESSION_COOKIE_SECURE=false

# Login-Benutzer, wird bei "manage.py migrate" angelegt/aktualisiert.
# Entweder Klartext-Passwort (nur lokal!) oder Argon2-Hash
# (python backend/manage.py hash-password).
ADMIN_USERNAME=schuetze
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Beispieldaten in leere DB schreiben
SEED_DEMO_DATA=true

# Ablage der Fotos (Standard: ./data/fotos)
# UPLOAD_DIR=

# Standard-Etikettengröße in mm (BREITExHÖHE)
LABEL_SIZE=90x60
